{
  "info": {
    "name": "Lab 3 - Books REST API",
    "description": "Success and failure test cases for the Lab 3 REST API. Set the baseUrl variable to your local or deployed URL, then run the collection in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "createdId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Success cases",
      "item": [
        {
          "name": "1. GET /books (defaults)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"limit defaults to 10 and offset to 0\", () => { const j = pm.response.json(); pm.expect(j.limit).to.eql(10); pm.expect(j.offset).to.eql(0); });",
                  "pm.test(\"data is an array\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. GET /books?search_q=clean (partial title match)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=clean",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search_q",
                  "value": "clean"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"every title contains clean\", () => pm.response.json().data.forEach(b => pm.expect(b.title.toLowerCase()).to.include(\"clean\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. GET /books?order_by=price&order=DESC",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"prices are descending\", () => { const p = pm.response.json().data.map(b => b.price); for (let i = 1; i < p.length; i++) pm.expect(p[i-1]).to.be.at.least(p[i]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. GET /books?limit=3&offset=3 (pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?limit=3&offset=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                },
                {
                  "key": "offset",
                  "value": "3"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"3 books returned\", () => pm.expect(pm.response.json().count).to.eql(3));",
                  "pm.test(\"offset echoed back\", () => pm.expect(pm.response.json().offset).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. GET /books?min_price=500&max_price=900 (price range)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=500&max_price=900&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "min_price",
                  "value": "500"
                },
                {
                  "key": "max_price",
                  "value": "900"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"all prices within range\", () => pm.response.json().data.forEach(b => { pm.expect(b.price).to.be.within(500, 900); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. GET /books (all filters combined)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=clean&max_price=800&order_by=title&order=ASC&limit=5&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search_q",
                  "value": "clean"
                },
                {
                  "key": "max_price",
                  "value": "800"
                },
                {
                  "key": "order_by",
                  "value": "title"
                },
                {
                  "key": "order",
                  "value": "ASC"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"response has data array\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. GET /books/1 (single book)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns book 1\", () => pm.expect(pm.response.json().data.id).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. POST /books (create)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Book\",\n  \"author\": \"Lab Student\",\n  \"price\": 350\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"id returned\", () => pm.expect(pm.response.json().data.id).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"createdId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "9. PUT /books/{{createdId}} (update)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{createdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{createdId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Book (edited)\",\n  \"author\": \"Lab Student\",\n  \"price\": 399\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"title updated\", () => pm.expect(pm.response.json().data.title).to.include(\"edited\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "10. DELETE /books/{{createdId}}",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{createdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{createdId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"message present\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
